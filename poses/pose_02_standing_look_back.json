  "meta": {
    "id": "pose_02_standing_look_back",
    "name": "Standing, looking back over the right shoulder",
    "description": "Standing with the weight shifted onto the left leg. Pelvis, spine, neck and head all turn to the character's right, so the face looks back over the right shoulder. Right foot set a little behind and turned out; both arms hang relaxed, the right arm slightly behind the body. Left/right are the character's own.",
    "targetModels": [
      "female",
      "male"
    ],
    "assumptions": [
      "Turn split over the chain to stay inside the per-bone limits and avoid skinning folds: pelvis 14 deg, spine 34 deg in total, neck 28 deg and head 26 deg to the right (~100 deg overall).",
      "Feet placed with two-bone IK: left ankle under the left hip, right ankle 10 cm behind and turned out 20 deg; both soles flat.",
      "Authored on rig/female.glb; the male uses the same rotations and the hips-height-relative root offset. The root height is the mean of the female and male heights that put the contact on y = 0, so both models land within a few millimetres of the floor."
    ],
    "generator": "/tmp/pose-author/build_all.py + p0N.py (poser authoring scripts, kept outside the repository)"
  },
