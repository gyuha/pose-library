  "meta": {
    "id": "pose_06_walking",
    "name": "Walking, left foot forward",
    "description": "Mid-stride walk. Left leg forward with a nearly straight knee, landing on the heel with the toes up; right leg behind with the heel raised, pushing off from the ball of the foot. Arms swing opposite to the legs: right arm forward with a slightly bent elbow, left arm back. Left/right are the character's own.",
    "targetModels": [
      "female",
      "male"
    ],
    "assumptions": [
      "Stride ~50 cm (female); the lowest sole touches the floor.",
      "Authored on rig/female.glb; the male uses the same rotations and the hips-height-relative root offset. The root height is the mean of the female and male heights that put the contact on y = 0, so both models land within a few millimetres of the floor."
    ],
    "generator": "/tmp/pose-author/build_all.py + p0N.py (poser authoring scripts, kept outside the repository)"
  },
