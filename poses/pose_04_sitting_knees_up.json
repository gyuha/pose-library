  "meta": {
    "id": "pose_04_sitting_knees_up",
    "name": "Sitting on the floor, knees up, arms on the knees",
    "description": "Sitting on the floor with both knees raised and apart and both feet flat in front. The torso leans forward, both forearms rest over the knees and the hands meet between the shins. Head up, looking forward. Left/right are the character's own.",
    "targetModels": [
      "female",
      "male"
    ],
    "assumptions": [
      "No seat: the buttocks rest on the floor plane (lowest vertex at y = 0).",
      "Knees kept apart (thighs abducted ~19 deg and externally rotated): with the knees together, hip flexion above ~110 deg pushes the thigh shell into the abdomen shell.",
      "Clavicles slightly raised and protracted to keep the shoulder shell out of the chest when the arms reach forward.",
      "Root shifted 8 cm backwards (model space) to centre the figure for previews.",
      "Authored on rig/female.glb; the male uses the same rotations and the hips-height-relative root offset. The root height is the mean of the female and male heights that put the contact on y = 0, so both models land within a few millimetres of the floor."
    ],
    "generator": "/tmp/pose-author/build_all.py + p0N.py (poser authoring scripts, kept outside the repository)"
  },
