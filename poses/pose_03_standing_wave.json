  "meta": {
    "id": "pose_03_standing_wave",
    "name": "Standing, waving with the right hand",
    "description": "Standing upright, weight slightly on the right leg. Right upper arm raised out to the side to about shoulder height with the elbow bent so the forearm points up; the open right palm faces forward at head height. Left arm hangs relaxed. Head turned and tilted slightly to the left. Left/right are the character's own.",
    "targetModels": [
      "female",
      "male"
    ],
    "assumptions": [
      "Right arm placed analytically (elbow and wrist targets), forearm twist chosen so the palm faces forward within the wrist limits; fingers nearly straight, thumb slightly open.",
      "Authored on rig/female.glb; the male uses the same rotations and the hips-height-relative root offset. The root height is the mean of the female and male heights that put the contact on y = 0, so both models land within a few millimetres of the floor."
    ],
    "generator": "/tmp/pose-author/build_all.py + p0N.py (poser authoring scripts, kept outside the repository)"
  },
